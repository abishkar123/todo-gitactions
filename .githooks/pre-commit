#!/bin/sh

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname "$0")" && pwd)
SCAN_SCRIPT="$SCRIPT_DIR/../scripts/Invoke-SecretScan.ps1"

if command -v pwsh >/dev/null 2>&1; then
    exec pwsh -NoProfile -File "$SCAN_SCRIPT"
fi

if command -v powershell.exe >/dev/null 2>&1; then
    exec powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$SCAN_SCRIPT"
fi

echo "pre-commit hook skipped: PowerShell is not installed. Install 'pwsh' (recommended on macOS/Linux) or make 'powershell.exe' available on PATH." >&2
exit 0
